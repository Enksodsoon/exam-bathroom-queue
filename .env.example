# Local Development (optional)
# Directory for FileSessionStore atomic JSON files when Redis is not configured.
# Defaults to ./.data
# EXAMQ_DATA_DIR=./.data

# Production Storage (required when VERCEL=1)
# Provide UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# (or Vercel KV aliases KV_REST_API_URL + KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel KV aliases (used if UPSTASH_REDIS_REST_* are not set):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
